# Copy this file to .env.local and fill in real values.

# MongoDB connection string (MongoDB Atlas free tier works fine):
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ritikomal?retryWrites=true&w=majority

# Any long random string — used to sign the login session cookie (JWT).
JWT_SECRET=change-this-to-something-long-and-random

# Needed for image uploads (app/api/upload) — images are stored on
# Cloudinary. Sign up free at cloudinary.com, then copy these three values
# from your Cloudinary dashboard (Home screen, top of the page):
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional but recommended for reliable calling on mobile data / behind
# strict NATs. Calls use a free shared public TURN relay by default, which
# can be rate-limited and occasionally drop/fail to connect. For guaranteed
# reliability, get your own free TURN credentials (e.g. sign up free at
# https://www.metered.ca/tools/openrelay/, or use Twilio NTS / Cloudflare
# Calls) and fill these in — they get added on top of the free relay.
# Must be prefixed NEXT_PUBLIC_ so the browser can use them.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
